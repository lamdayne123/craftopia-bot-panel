{
  "name": "craftopia-bot-panel",
  "version": "2.0.0",
  "description": "Craftopia Minecraft Java Bot Hosting Platform (Vercel + Supabase Realtime + Multi-Worker Orchestrator)",
  "main": "dist/server.js",
  "scripts": {
    "build:backend": "tsc",
    "build:frontend": "npm --prefix client run build",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "node dist/server.js",
    "test": "npm run build:backend && node --test --test-force-exit tests/*.test.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "pg": "^8.14.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.11",
    "typescript": "^5.8.3"
  }
}
