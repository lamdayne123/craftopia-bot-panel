# Database (Supabase Postgres connection string; omit only for local JSON dev/tests)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Managed Realtime (Supabase Realtime Broadcast)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
REALTIME_CHANNEL=craftopia-orchestrator

# Security & Encryption
SESSION_SECRET=replace-with-64-char-random-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-char-hex-aes256-key
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-hmac-secret

# Orchestrator Tuning
WORKER_HEARTBEAT_TIMEOUT_MS=30000
MIGRATION_COOLDOWN_MS=60000

# Optional initial admin bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
